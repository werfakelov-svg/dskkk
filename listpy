local script_name_f9 = "[NektoHub]"
local GetIp = game:HttpGet("https://v4.ident.me/")

local function ban_list(link)
	local success, response = pcall(function()
		return game:HttpGet(link)
	end)
	if not success then
		warn(script_name_f9 .. " Failed")
		return false
	end
	
	local function HWID(): string
		local raw = tostring(gethwid())
		local hex = ""

		for i = 1, #raw do
			hex ..= string.format("%02x", string.byte(raw, i))
		end

		hex = (hex .. string.rep("0", 32)):sub(1, 32)
		return string.format("%s-%s-%s-%s-%s",hex:sub(1, 8),hex:sub(9, 12),	hex:sub(13, 16),hex:sub(17, 20),hex:sub(21, 32))
	end

	local player = game.Players.LocalPlayer

	local lines = {}
	for line in string.gmatch(response, "[^\n]+") do
		table.insert(lines, line)
	end

	for _, line in ipairs(lines) do
		local parts = {}
		for part in string.gmatch(line, "[^|]+") do
			table.insert(parts, part)
		end

		if #parts >= 1 then
			local bannedHwid = parts[1]:gsub("%s+", "") or ""
			local bannedName = parts[2] and parts[2]:gsub("%s+", "") or ""
			local bannedIP = parts[3]:gsub("%s+", "") or ""
			local reason = parts[4] or "No reason"
			local banTime = parts[5] or "Unknown"
			local expires = parts[6] or "Permanent"

			if bannedHwid == HWID() or bannedName == player.Name or bannedIP == tostring(GetIp) then
				local kickMessage = string.format(
					"You are banned from NektoHub!\nReason: %s\nTime: %s\nExpires: %s\n\nAppeal here: https://discord.gg/U65StBRNr2(Copied)",
					reason,
					banTime,
					expires
				)
				setclipboard("https://discord.gg/U65StBRNr2")
				player:Kick(kickMessage)
				return true
			end
		end
	end

	return false
end

