local function HWID(): string
	local raw = tostring(gethwid())
	local hex = ""

	for i = 1, #raw do
		hex ..= string.format("%02x", string.byte(raw, i))
	end

	hex = (hex .. string.rep("0", 32)):sub(1, 32)
	return string.format("%s-%s-%s-%s-%s",hex:sub(1, 8),hex:sub(9, 12),	hex:sub(13, 16),hex:sub(17, 20),hex:sub(21, 32))
end
